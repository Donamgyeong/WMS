# Local development only; Compose uses the same credentials.
POSTGRES_USER=wms
POSTGRES_PASSWORD=wms_dev
POSTGRES_DB=wms
POSTGRES_PORT=5433
APP_PORT=3001
# Host-side npm commands; Compose overrides the hostname to db.
DATABASE_URL=postgresql://wms:wms_dev@localhost:5433/wms

# Generate a unique secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
